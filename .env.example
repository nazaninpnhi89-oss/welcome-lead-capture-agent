# کپی کنید به .env و مقدار واقعی را بگذارید
ANTHROPIC_API_KEY=sk-ant-...
# مدل تحلیل (پیش‌فرض claude-opus-5-5؛ برای هزینه‌ی کمتر: claude-haiku-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- جایگزین رایگان: Ollama ---
# LLM_PROVIDER=ollama                 # claude | ollama | mock
# OLLAMA_HOST=http://localhost:11434  # محلی (رایگان). برای Ollama Cloud: https://ollama.com
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_API_KEY=                     # فقط برای Ollama Cloud

# --- اینستاگرام ---
# IG_ACCESS_TOKEN=     # توکن پیج (Meta ← API setup with Instagram login ← Generate token)
# IG_APP_SECRET=       # Instagram app secret
# IG_VERIFY_TOKEN=     # یک رمز دلخواه؛ همین را در تنظیمات webhook در Meta هم بنویسید
# WEBHOOK_PORT=8000
